<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/islamic_pattern_bg"
            android:scaleType="centerCrop"
            android:alpha="0.08"
            android:importantForAccessibility="no"/>

    <!-- محتوى التابات -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav">

        <!-- ===== تاب أوقات الصلاة ===== -->
        <LinearLayout
            android:id="@+id/tab_prayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:visibility="visible">

            <TextView android:id="@+id/txt_city"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="مكة المكرمة" android:textSize="22sp"
                android:textColor="#ffd700" android:textStyle="bold"
                android:layout_gravity="center"/>

            <TextView android:id="@+id/txt_date"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#aaaaaa"
                android:layout_gravity="center" android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="#1a2a3a"
                app:cardElevation="8dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:paddingVertical="20dp">
                    <TextView android:id="@+id/txt_next_prayer"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="الصلاة القادمة" android:textSize="14sp" android:textColor="#aaaaaa"/>
                    <TextView android:id="@+id/txt_countdown"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="00:00:00" android:textSize="44sp"
                        android:textStyle="bold" android:textColor="#ffd700"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="أوقات الصلاة" android:textSize="16sp"
                android:textColor="#aaaaaa" android:gravity="end" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#1a2a3a" app:cardElevation="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center_vertical" android:paddingVertical="8dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingHorizontal="20dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_fajr"/>
                        <TextView android:id="@+id/txt_fajr" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="الفجر" android:textSize="17sp" android:textColor="#ffffff"
                            android:gravity="end" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/txt_fajr_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="--:--"
                            android:textSize="17sp" android:textColor="#ffd700"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2a3a4a" android:layout_marginHorizontal="20dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingHorizontal="20dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_dhuhr"/>
                        <TextView android:id="@+id/txt_dhuhr" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="الظهر" android:textSize="17sp" android:textColor="#ffffff"
                            android:gravity="end" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/txt_dhuhr_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="--:--"
                            android:textSize="17sp" android:textColor="#ffd700"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2a3a4a" android:layout_marginHorizontal="20dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingHorizontal="20dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_asr"/>
                        <TextView android:id="@+id/txt_asr" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="العصر" android:textSize="17sp" android:textColor="#ffffff"
                            android:gravity="end" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/txt_asr_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="--:--"
                            android:textSize="17sp" android:textColor="#ffd700"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2a3a4a" android:layout_marginHorizontal="20dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingHorizontal="20dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_maghrib"/>
                        <TextView android:id="@+id/txt_maghrib" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="المغرب" android:textSize="17sp" android:textColor="#ffffff"
                            android:gravity="end" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/txt_maghrib_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="--:--"
                            android:textSize="17sp" android:textColor="#ffd700"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2a3a4a" android:layout_marginHorizontal="20dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingHorizontal="20dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_isha"/>
                        <TextView android:id="@+id/txt_isha" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="العشاء" android:textSize="17sp" android:textColor="#ffffff"
                            android:gravity="end" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/txt_isha_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="--:--"
                            android:textSize="17sp" android:textColor="#ffd700"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ===== تاب الأذكار ===== -->
        <LinearLayout
            android:id="@+id/tab_azkar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_primary"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="الأذكار والأدعية" android:textSize="24sp" android:textStyle="bold"
                android:textColor="#ffd700" android:layout_gravity="center"
                android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2c3e50">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView android:id="@+id/tv_hijri_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ffd700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/amiri"/>
                    <TextView android:id="@+id/tv_miladi_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#aaaaaa"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
                android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">

                    <androidx.cardview.widget.CardView android:id="@+id/card_morning"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="أذكار الصباح" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:id="@+id/card_evening"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="أذكار المساء" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:id="@+id/card_after_salah"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="أذكار بعد الصلاة" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:id="@+id/card_wakeup"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="أذكار الاستيقاظ" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:id="@+id/card_duas"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="الأدعية" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:id="@+id/card_iftitah"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="دعاء الاستفتاح" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:id="@+id/card_sleep"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="أذكار النوم" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView android:id="@+id/card_mutanawia"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="6dp"
                        app:cardCornerRadius="12dp" app:cardBackgroundColor="#2c3e50">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="أذكار متنوعة" android:textColor="#ffd700"
                            android:gravity="center" android:padding="24dp" android:textSize="16sp"/>
                    </androidx.cardview.widget.CardView>

                </GridLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ===== تاب المسبحة ===== -->
        <LinearLayout
            android:id="@+id/tab_tasbih"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_primary"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="﴿فَاذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا﴾"
                android:textColor="#AAAAAA" android:textSize="14sp"
                android:gravity="center" android:fontFamily="@font/amiri"
                android:layout_marginTop="16dp"/>

            <TextView android:id="@+id/txt_phrase"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="36sp"
                android:textStyle="bold" android:fontFamily="@font/amiri"/>

            <TextView android:id="@+id/txt_target"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:layout_marginTop="8dp"
                android:textColor="@color/gold" android:textSize="16sp"/>

            <FrameLayout android:layout_width="220dp" android:layout_height="220dp"
                android:layout_gravity="center" android:layout_marginTop="24dp">

                <View android:layout_width="220dp" android:layout_height="220dp"
                    android:background="@drawable/circle_outer"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tap"
                    android:layout_width="190dp" android:layout_height="190dp"
                    android:layout_gravity="center" android:backgroundTint="#0D1B2A"
                    app:cornerRadius="95dp" app:elevation="8dp" android:text=""/>

                <TextView android:id="@+id/txt_count"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textColor="#FFFFFF"
                    android:textSize="64sp" android:textStyle="bold" android:text="0"/>

            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="#1E2A3A" android:padding="12dp">
                    <TextView android:id="@+id/txt_stage"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/gold" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="المرحلة" android:textColor="#AAAAAA" android:textSize="12sp"/>
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="0dp"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="#1E2A3A" android:padding="12dp">
                    <TextView android:id="@+id/txt_total"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/gold" android:textSize="20sp"
                        android:textStyle="bold" android:text="0"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="إجمالي التسبيحات" android:textColor="#AAAAAA" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_margin="16dp" android:text="↺ إعادة تعيين"
                android:textColor="@color/gold"
                app:strokeColor="@color/gold" app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

        </LinearLayout>

        <!-- ===== تاب القبلة ===== -->
        <RelativeLayout
            android:id="@+id/tab_qibla"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0A0A14"
            android:visibility="gone">

            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/islamic_pattern_bg" android:scaleType="centerCrop" android:alpha="0.55"/>
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/qibla_center_overlay"/>

            <TextView android:id="@+id/tv_basmala"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_centerHorizontal="true" android:layout_marginTop="16dp"
                android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
                android:textColor="#C8A84B" android:textSize="13sp" android:fontFamily="@font/amiri"/>

            <TextView android:id="@+id/tv_title_q"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/tv_basmala" android:layout_centerHorizontal="true"
                android:text="اتِّجَاهُ القِبْلَة" android:textColor="#D4AF37"
                android:textSize="32sp" android:fontFamily="@font/amiri" android:textStyle="bold"/>

            <View android:id="@+id/divider_q"
                android:layout_width="120dp" android:layout_height="1dp"
                android:layout_below="@id/tv_title_q" android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp" android:background="#80D4AF37"/>

            <TextView android:id="@+id/tv_ornament_q"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/divider_q" android:layout_centerHorizontal="true"
                android:text="✦" android:textColor="#D4AF37" android:textSize="10sp"/>

            <TextView android:id="@+id/tv_city_q"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/tv_ornament_q" android:layout_centerHorizontal="true"
                android:textColor="#F0D080" android:textSize="18sp"
                android:fontFamily="@font/amiri" android:textStyle="bold"/>

            <LinearLayout android:id="@+id/ll_info_q"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/tv_city_q" android:layout_centerHorizontal="true"
                android:orientation="horizontal">
                <TextView android:id="@+id/tv_degrees_q"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#90D4AF37" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  ✦  " android:textColor="#90D4AF37" android:textSize="10sp"/>
                <TextView android:id="@+id/tv_distance_q"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#90D4AF37" android:textSize="13sp"/>
            </LinearLayout>

            <FrameLayout android:id="@+id/compass_frame_q"
                android:layout_width="280dp" android:layout_height="280dp"
                android:layout_centerInParent="true">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/compass_bg_circle"/>
                <ImageView android:id="@+id/iv_compass_ring_q"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/compass_ring"/>
                <ImageView android:id="@+id/iv_qibla_arrow_q"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/qibla_arrow"/>
            </FrameLayout>

            <TextView android:id="@+id/tv_facing_q"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/compass_frame_q" android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp" android:textSize="18sp"
                android:fontFamily="@font/amiri" android:textStyle="bold" android:visibility="invisible"/>

            <TextView android:id="@+id/tv_status_q"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_below="@id/tv_facing_q" android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp" android:text="جارٍ تحديد الموقع..."
                android:textColor="#90D4AF37" android:textSize="13sp" android:fontFamily="@font/amiri"/>

        </RelativeLayout>

                <!-- ===== تاب الإعدادات ===== -->
        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_primary"
            android:layoutDirection="rtl"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginVertical="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="المدينة"
                        android:textColor="#ffd700"
                        android:textSize="14sp"
                        android:paddingBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinner_city_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_bg"
                        android:layout_marginBottom="16dp"/>

                    <TextView style="@style/SectionLabel" android:text="@string/lbl_method"/>
                    <Spinner android:id="@+id/spinner_method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_bg"
                        android:layout_marginBottom="16dp"/>

                    <TextView style="@style/SectionLabel" android:text="@string/lbl_madhab"/>
                    <Spinner android:id="@+id/spinner_madhab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_bg"
                        android:layout_marginBottom="16dp"/>

                    <TextView style="@style/SectionLabel" android:text="@string/lbl_adhan_voice"/>
                    <Spinner android:id="@+id/spinner_adhan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_bg"
                        android:layout_marginBottom="20dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_adhan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶️ معاينة الأذان"
                        android:textColor="@color/gold"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <Switch android:id="@+id/sw_adhan" style="@style/SettingSwitch"
                        android:text="@string/sw_adhan"/>
                    <Switch android:id="@+id/sw_morning" style="@style/SettingSwitch"
                        android:text="@string/sw_morning"/>
                    <Switch android:id="@+id/sw_evening" style="@style/SettingSwitch"
                        android:text="@string/sw_evening"/>
                    <Switch android:id="@+id/sw_vibrate" style="@style/SettingSwitch"
                        android:text="@string/sw_vibrate"/>
                    <Switch android:id="@+id/sw_dark" style="@style/SettingSwitch"
                        android:text="@string/sw_dark"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginVertical="16dp"/>

                    <TextView style="@style/SectionLabel" android:text="@string/lbl_reliability"/>

                    <TextView android:id="@+id/lbl_exact_alarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:paddingBottom="6dp"
                        android:text="@string/exact_alarm_needed"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_exact_alarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/btn_exact_alarm"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_battery"
                        app:cornerRadius="12dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginVertical="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="حول التطبيق"
                        android:textColor="@color/gold"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                </LinearLayout>
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="16dp"
                android:text="@string/btn_save"
                android:textColor="@color/bg_primary"
                android:backgroundTint="@color/gold"
                app:cornerRadius="14dp"/>

        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#060B18"
        
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="32dp"
        app:menu="@menu/bottom_nav_menu"/>

</RelativeLayout>
