<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <Spinner
            android:id="@+id/spinner_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/spinner_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"/>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#aaaaaa"
            android:gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- بطاقة الصلاة القادمة -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1a2a3a"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textSize="14sp"
                android:textColor="#aaaaaa"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txt_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textSize="32sp"
                android:textColor="#ffd700"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txt_next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:10 ص"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txt_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="36sp"
                android:textColor="#ffd700"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- أوقات الصلاة - تملأ باقي الشاشة -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مواقيت اليوم"
        android:textSize="16sp"
        android:textColor="#aaaaaa"
        android:gravity="end"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1a2a3a"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center_vertical">

            <!-- الفجر -->
            <LinearLayout
                android:id="@+id/row_fajr"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_fajr"/>
                <TextView android:id="@+id/txt_fajr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الفجر"
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/txt_fajr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="04:10 ص"
                    android:textSize="16sp"
                    android:textColor="#ffd700"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2a3a4a" android:layout_marginHorizontal="16dp"/>

            <!-- الشروق -->
            <LinearLayout
                android:id="@+id/row_sunrise"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sunrise"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الشروق"
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/txt_sunrise_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:33 ص"
                    android:textSize="16sp"
                    android:textColor="#ffd700"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2a3a4a" android:layout_marginHorizontal="16dp"/>

            <!-- الظهر -->
            <LinearLayout
                android:id="@+id/row_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_dhuhr"/>
                <TextView android:id="@+id/txt_dhuhr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الظهر"
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/txt_dhuhr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:21 م"
                    android:textSize="16sp"
                    android:textColor="#ffd700"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2a3a4a" android:layout_marginHorizontal="16dp"/>

            <!-- العصر -->
            <LinearLayout
                android:id="@+id/row_asr"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_asr"/>
                <TextView android:id="@+id/txt_asr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="العصر"
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/txt_asr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03:40 م"
                    android:textSize="16sp"
                    android:textColor="#ffd700"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2a3a4a" android:layout_marginHorizontal="16dp"/>

            <!-- المغرب -->
            <LinearLayout
                android:id="@+id/row_maghrib"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_maghrib"/>
                <TextView android:id="@+id/txt_maghrib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="المغرب"
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/txt_maghrib_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:03 م"
                    android:textSize="16sp"
                    android:textColor="#ffd700"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2a3a4a" android:layout_marginHorizontal="16dp"/>

            <!-- العشاء -->
            <LinearLayout
                android:id="@+id/row_isha"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_isha"/>
                <TextView android:id="@+id/txt_isha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="العشاء"
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/txt_isha_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:33 م"
                    android:textSize="16sp"
                    android:textColor="#ffd700"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
