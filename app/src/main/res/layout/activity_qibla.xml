<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14">

    <!-- النقش الإسلامي الذهبي - ظاهر وواضح -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/islamic_pattern_bg"
        android:scaleType="centerCrop"
        android:alpha="0.55"/>

    <!-- تدرج داكن فقط في المنتصف لإظهار البوصلة -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/qibla_center_overlay"/>

    <!-- بسم الله -->
    <TextView
        android:id="@+id/tv_basmala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
        android:textColor="#C8A84B"
        android:textSize="14sp"
        android:fontFamily="@font/amiri"/>

    <!-- العنوان -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_basmala"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="اتِّجَاهُ القِبْلَة"
        android:textColor="#D4AF37"
        android:textSize="36sp"
        android:fontFamily="@font/amiri"
        android:textStyle="bold"/>

    <!-- خط زخرفي -->
    <View
        android:id="@+id/divider_top"
        android:layout_width="140dp"
        android:layout_height="1dp"
        android:layout_below="@id/tv_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:background="#90D4AF37"/>

    <TextView
        android:id="@+id/tv_ornament"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider_top"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="3dp"
        android:text="✦"
        android:textColor="#D4AF37"
        android:textSize="11sp"/>

    <!-- مكة المكرمة -->
    <TextView
        android:id="@+id/tv_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_ornament"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:textColor="#F0D080"
        android:textSize="20sp"
        android:fontFamily="@font/amiri"
        android:textStyle="bold"/>

    <!-- المسافة والدرجة -->
    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_city"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_degrees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90D4AF37"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ✦  "
            android:textColor="#90D4AF37"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90D4AF37"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- إطار البوصلة -->
    <FrameLayout
        android:id="@+id/compass_frame"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_centerInParent="true">

        <!-- خلفية دائرية داكنة للبوصلة -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/compass_bg_circle"/>

        <!-- البوصلة الدوارة -->
        <ImageView
            android:id="@+id/iv_compass_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/compass_ring"/>

        <!-- سهم القبلة -->
        <ImageView
            android:id="@+id/iv_qibla_arrow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/qibla_arrow"/>

    </FrameLayout>

    <!-- نص المواجهة -->
    <TextView
        android:id="@+id/tv_facing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/compass_frame"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:textSize="20sp"
        android:fontFamily="@font/amiri"
        android:textStyle="bold"
        android:visibility="invisible"/>

    <!-- الحالة -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_facing"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:text="جارٍ تحديد الموقع..."
        android:textColor="#90D4AF37"
        android:textSize="13sp"
        android:fontFamily="@font/amiri"/>

    <!-- زر إعادة المحاولة -->
    <Button
        android:id="@+id/btn_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:text="تحديد الموقع"
        android:backgroundTint="#D4AF37"
        android:textColor="#0D0D1A"
        android:visibility="gone"/>

</RelativeLayout>
