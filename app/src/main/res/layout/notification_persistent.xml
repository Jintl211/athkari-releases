<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A3A5C"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <!-- الصف الأول: اللوغو + التاريخ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_athkari_logo"
            android:scaleType="fitCenter"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/notif_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/notif_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0C4DE"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- خط فاصل -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A5A8C"
        android:layout_marginVertical="8dp"/>

    <!-- الصف الثاني: اسم الصلاة + الوقت -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_prayer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0C4DE"
            android:textSize="13sp"
            android:text="الصلاة القادمة: "/>

        <TextView
            android:id="@+id/notif_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/notif_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0C4DE"
            android:textSize="13sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- الصف الثالث: العد التنازلي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0C4DE"
            android:textSize="13sp"
            android:text="⏱ متبقي: "/>

        <TextView
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF6B6B"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
