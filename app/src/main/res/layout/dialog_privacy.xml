<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شروط الاستخدام وسياسة الخصوصية"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:gravity="center"
            android:fontFamily="@font/amiri"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تطبيق آذكاري"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:fontFamily="@font/amiri"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="باستخدامك للتطبيق فإنك توافق على هذه الشروط. تطبيق آذكاري يوفر أوقات الصلاة وأذكار الصباح والمساء وتحديد القبلة والأدعية، ويعمل بالكامل دون إنترنت."
            android:textSize="13sp"
            android:textColor="#cccccc"
            android:fontFamily="@font/amiri"
            android:lineSpacingMultiplier="1.6"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الأذونات المطلوبة:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:fontFamily="@font/amiri"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="يطلب التطبيق إذن الإشعارات للتذكير بأوقات الصلاة، وإذن الظهور فوق التطبيقات لعرض التذكيرات، وإذن العمل في الخلفية لضمان وصول الإشعارات في وقتها. جميع هذه الأذونات لأغراض دينية فقط ولا تُستخدم لأي غرض آخر."
            android:textSize="13sp"
            android:textColor="#cccccc"
            android:fontFamily="@font/amiri"
            android:lineSpacingMultiplier="1.6"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الخصوصية:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:fontFamily="@font/amiri"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لا يجمع التطبيق أي بيانات شخصية ولا يرسلها لأي جهة. الموقع الجغرافي يُستخدم محلياً فقط لحساب أوقات الصلاة واتجاه القبلة. لا يوجد إعلانات ولا تتبع ولا مشاركة بيانات مع أطراف ثالثة."
            android:textSize="13sp"
            android:textColor="#cccccc"
            android:fontFamily="@font/amiri"
            android:lineSpacingMultiplier="1.6"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="للتواصل: jintl850@gmail.com"
            android:textSize="13sp"
            android:textColor="#ffd700"
            android:fontFamily="@font/amiri"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الإصدار الحالي: 1.8"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="@font/amiri"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>